# ARES arbiter — environment template.
#
# Secrets are delivered by Infisical: the values live in this project's Development,
# Staging and Production environments and reach the process through `infisical run`
# (see the Secrets section in README.md). `npm run dev`, `dev:all` and `arbiter` are
# already wrapped, so the arbiter keeps reading `process.env` as before and no
# application code changes; after the migration there is no `.env` on disk.
#
# This file is the key set, not a store: the names the arbiter reads, and their
# meaning. It is tracked and MUST NOT contain a real value for anything. Every entry
# here is a placeholder, and an operator who pastes a live key into it has leaked it.
#
# Vite exposes only VITE_* variables to the browser. Only public switches belong there;
# never prefix credentials, session keys or operator tokens with VITE_.
# Public Sentry browser switch, evaluated at build/start of Vite. Set false to disable.
VITE_SENTRY_ENABLED=true

# ── Arbiter identity ────────────────────────────────────────────────────────────
# Stable key for per-agent telemetry MAC derivation. Without it the enrolled fleet is
# regenerated on every boot and previously issued agent keys stop verifying.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARES_MASTER_KEY=

# Operator token for the console control plane. Minimum 32 characters. If unset, a
# single-session token is generated at boot and printed to the arbiter log.
ARES_OPERATOR_TOKEN=

# Origins permitted to call the API from a browser. Comma separated, exact match.
ARES_CONSOLE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set to 1 only when a reverse proxy you control sits in front of this process.
# Enabling it makes the rightmost x-forwarded-for entry authoritative for rate limits.
ARES_TRUST_PROXY=0

# Global signup ceiling, per minute. Unset means the built-in default. Raise it for a
# launch or an automated suite; the per-source signup gate is not adjustable.
ARES_SIGNUP_PER_MIN=

# ── Accounts, sessions and data ────────────────────────────────────────────────
# Signing key for sessions and CSRF tokens. Rotating it invalidates every session.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ARES_SESSION_KEY=

# SQLite file for accounts, sessions, consents, subscriptions and the audit log.
# Keep it outside every asset root, and keep it out of backups that leave the host.
ARES_DB=.ares-data/ares.db

# Directory for stored artefacts. Created mode 0700; never inside the served asset root.
ARES_UPLOAD_DIR=.ares-data/uploads

# Bootstrap administrator. Created on first boot only if no ADMIN account exists, and
# flagged for a forced password change. Remove it from the environment once the account
# exists; leaving it here means the credential stays valid indefinitely.
ARES_BOOTSTRAP_ADMIN_EMAIL=
ARES_BOOTSTRAP_ADMIN_PASSWORD=

# ── Cookies and transport ──────────────────────────────────────────────────────
# Set to 1 in production. Adds `Secure` to every session cookie. Leave 0 for local
# HTTP, where a Secure cookie would simply never be sent back.
ARES_COOKIE_SECURE=0

# Direct TLS, for a deployment that terminates its own HTTPS instead of sitting behind
# a proxy. Both must be set together or the process stays on plain HTTP.
ARES_TLS_CERT=
ARES_TLS_KEY=

# ── Mail relay (build requests, renewal reminders) ─────────────────────────────
# Without a key, relayed mail is appended to the spool instead of being sent, and the
# arbiter reports SPOOLED. Requests are never dropped for want of a credential.
RESEND_API_KEY=
ARES_REQUEST_TO=cagelove094@gmail.com
ARES_REQUEST_FROM=ARES Arbiter <onboarding@resend.dev>
ARES_REQUEST_ENDPOINT=https://api.resend.com/emails
ARES_REQUEST_SPOOL=.ares-requests.log

# ── Retention and subscriptions ────────────────────────────────────────────────
# Days an uploaded artefact is retained before the sweeper deletes it. Also the figure
# the privacy policy states, so changing it means changing the policy copy too.
ARES_UPLOAD_RETENTION_DAYS=30

# Days before a renewal date that the reminder is sent. Auto-renewing accounts are
# warned exactly once per period, and only inside this window.
ARES_RENEWAL_NOTICE_DAYS=14

# ── Process ────────────────────────────────────────────────────────────────────
PORT=8787

# `production` turns the readiness checks from advisory into refusing: a deployment with
# an insecure cookie, a generated session key, a short operator token or a plaintext
# remote origin exits 3 at boot instead of starting. Keep it as `development` on a
# workstation; a copy of this template must never silently be a production deployment.
NODE_ENV=development
